{
  "name": "mc-compiler",
  "displayName": "MC Compiler (ProgrammableFurnace)",
  "description": "语法高亮、保存即编译，并把 .mc 脚本的编译诊断标到编辑器里。复用可编程熔炉自带的编译器前端。",
  "version": "0.2.0",
  "publisher": "hjt458",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "mc",
    "programmablefurnace",
    "minecraft",
    "script"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:mc"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mc",
        "aliases": [
          "MC",
          "mc"
        ],
        "extensions": [
          ".mc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mc",
        "scopeName": "source.mc",
        "path": "./syntaxes/mc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mc.compileFile",
        "title": "MC: 编译当前文件",
        "icon": "$(beaker)"
      },
      {
        "command": "mc.compileAll",
        "title": "MC: 编译工作区所有 .mc",
        "icon": "$(beaker-done)"
      },
      {
        "command": "mc.showOutput",
        "title": "MC: 显示编译日志"
      },
      {
        "command": "mc.selectCompiler",
        "title": "MC: 选择编译器…",
        "category": "MC"
      },
      {
        "command": "mc.showProvenance",
        "title": "MC: 查看编译器出处",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mc.compileFile",
          "when": "resourceLangId == mc",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mc.compileFile",
          "when": "resourceLangId == mc"
        }
      ]
    },
    "configuration": {
      "title": "MC Compiler",
      "properties": {
        "mc.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存 .mc 文件时自动编译并刷新诊断。"
        },
        "mc.compilerJar": {
          "type": "string",
          "default": "",
          "description": "自定义编译器 jar（内含 McCompileCli）。留空则使用扩展内置的 compiler/mc-compiler.jar。"
        },
        "mc.compilerDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "扫描此目录下的 `*.jar` 作为可选编译器（默认 `compiler/jars`）。用 “MC: 选择编译器…” 切换。"
        },
        "mc.sourceRoot": {
          "type": "string",
          "default": "",
          "description": "仅在内置 jar 不可用、需要从源码现编时使用：包含 dev/programmablefurnace 的 Java 源码根目录（通常是 <模组>/src/main/java）。留空则从当前文件向上自动查找。"
        },
        "mc.javaBin": {
          "type": "string",
          "default": "java",
          "description": "java 可执行文件路径（默认从 PATH 查找）。"
        },
        "mc.javacBin": {
          "type": "string",
          "default": "",
          "description": "javac 可执行文件路径。留空则与 java 同目录，或从 PATH 查找。"
        },
        "mc.checkCompilerVersion": {
          "type": "boolean",
          "default": true,
          "description": "比较内置编译器的构建提交与工程 HEAD，不一致时在状态栏提示（需要工程是 git 仓库）。"
        }
      }
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/vscode-harness.cjs && node test/local.mjs",
    "test:ci": "node test/smoke.mjs && node test/vscode-harness.cjs",
    "build:compiler": "node tools/build-compiler.mjs"
  },
  "bin": {
    "mc-compile": "bin/mc-compile.cjs"
  }
}
